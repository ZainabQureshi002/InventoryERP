@model InventoryERP.Web.Models.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Details";
}
<div class="card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Purchase Invoice: @Model.InvoiceNo</h3>
        <a asp-action="Index" class="btn btn-default btn-sm">Back</a>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4"><strong>Supplier:</strong> @Model.Supplier?.Name</div>
            <div class="col-md-4"><strong>Date:</strong> @Model.PurchaseDate.ToString("dd MMM yyyy HH:mm")</div>
            <div class="col-md-4"><strong>Status:</strong> <span class="badge badge-success">@Model.Status</span></div>
        </div>
        <table class="table table-bordered">
            <thead class="thead-light">
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Cost</th>
                <th>Subtotal</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Product?.Name (@item.Product?.SKU)</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitCost.ToString("N2")</td>
                    <td>@item.Subtotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <th colspan="3" class="text-right">Grand Total</th>
                <th>@Model.TotalAmount.ToString("N2")</th>
            </tr>
            </tfoot>
        </table>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p><strong>Notes:</strong> @Model.Notes</p>
        }
        <p class="text-muted">Recorded by @Model.CreatedBy</p>
    </div>
</div>
