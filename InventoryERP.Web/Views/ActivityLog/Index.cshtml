@model List<InventoryERP.Web.Models.ActivityLog>
@{
    ViewData["Title"] = "Activity Log";

    string BadgeClass(string action) => action switch
    {
        "Create" => "badge-success",
        "Edit" => "badge-warning",
        "Delete" => "badge-danger",
        "Adjust" => "badge-primary",
        "View" => "badge-secondary",
        _ => "badge-light",
    };
}
<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">Activity Log</h3>
    </div>
    <div class="card-body">
        <form method="get" class="form-row align-items-end mb-3">
            <div class="form-group col-md-2">
                <label>Module</label>
                <select name="module" class="form-control form-control-sm">
                    <option value="">All</option>
                    @foreach (var m in (List<string>)ViewBag.Modules)
                    {
                        <option value="@m" selected="@(m == (string?)ViewBag.Module)">@m</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-2">
                <label>Action</label>
                <select name="actionType" class="form-control form-control-sm">
                    <option value="">All</option>
                    @foreach (var a in (List<string>)ViewBag.Actions)
                    {
                        <option value="@a" selected="@(a == (string?)ViewBag.ActionType)">@a</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-2">
                <label>User</label>
                <input type="text" name="user" value="@ViewBag.User" class="form-control form-control-sm" placeholder="Username" />
            </div>
            <div class="form-group col-md-2">
                <label>From</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label>To</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <button type="submit" class="btn btn-primary btn-sm btn-block"><i class="fas fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th style="width:160px">Time</th>
                <th>User</th>
                <th style="width:110px">Action</th>
                <th style="width:130px">Module</th>
                <th>Description</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-3">No activity recorded yet.</td></tr>
            }
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.UserName</td>
                    <td><span class="badge @BadgeClass(log.Action)">@log.Action</span></td>
                    <td>@log.Module</td>
                    <td>@log.Description</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <nav>
            <ul class="pagination pagination-sm justify-content-end mb-0">
                @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { module = ViewBag.Module, actionType = ViewBag.ActionType, user = ViewBag.User, from = ViewBag.From, to = ViewBag.To, page = p })">@p</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
