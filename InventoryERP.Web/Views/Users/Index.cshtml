@model List<(InventoryERP.Web.Models.ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "Users";
}
<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">All Users</h3>
        @if (User.IsInRole("Admin") || User.HasClaim("Permission", "Users.Create"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New User</a>
        }
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th style="width:200px">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var (u, roles) in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>
                        @foreach (var r in roles)
                        {
                            <span class="badge badge-secondary">@r</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Roles" asp-route-id="@u.Id" class="btn btn-xs btn-outline-secondary"><i class="fas fa-user-tag"></i> Roles</a>
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this user?');">
                            <button type="submit" class="btn btn-xs btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
