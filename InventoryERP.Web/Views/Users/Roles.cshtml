@model InventoryERP.Web.Models.ViewModels.UserRolesViewModel
@{
    ViewData["Title"] = "Assign Roles";
    var roles = (List<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.Roles;
}
<div class="card card-primary card-outline">
    <div class="card-header"><h3 class="card-title">Assign Roles: @Model.FullName (@Model.Email)</h3></div>
    <form asp-action="Roles" asp-route-id="@Model.UserId" method="post">
        <div class="card-body">
            @foreach (var role in roles)
            {
                var isChecked = Model.SelectedRoles.Contains(role.Name!);
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="selectedRoles" value="@role.Name" id="role_@role.Id" checked="@isChecked" />
                    <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                </div>
            }
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-default">Cancel</a>
        </div>
    </form>
</div>
