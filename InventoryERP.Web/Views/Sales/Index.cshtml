@model IEnumerable<InventoryERP.Web.Models.SalesOrder>
@{
    ViewData["Title"] = "Sales";
}
<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Sales Orders</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Sale</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Invoice No</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th style="width:100px">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.InvoiceNo</td>
                    <td>@o.Customer?.Name</td>
                    <td>@o.SaleDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@o.TotalAmount.ToString("N2")</td>
                    <td><span class="badge badge-success">@o.Status</span></td>
                    <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-xs btn-outline-info"><i class="fas fa-eye"></i> View</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
