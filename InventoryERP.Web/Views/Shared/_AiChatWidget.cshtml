<form id="aiAntiForgeryForm">@Html.AntiForgeryToken()</form>

<div id="aiChatButton" class="ai-chat-fab" title="AI Assistant">
    <i class="fas fa-robot"></i>
</div>

<div id="aiChatPanel" class="ai-chat-panel" hidden>
    <div class="ai-chat-header">
        <span><i class="fas fa-robot mr-2"></i>AI Assistant</span>
        <button type="button" id="aiChatClose" class="ai-chat-close">&times;</button>
    </div>
    <div id="aiChatMessages" class="ai-chat-messages"></div>
    <div class="ai-chat-input-row">
        <input type="text" id="aiChatInput" class="form-control form-control-sm" placeholder="Poochein... aaj kitni sale hui?" autocomplete="off" />
        <button type="button" id="aiChatSend" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i></button>
    </div>
</div>

<style>
    .ai-chat-fab {
        position: fixed; bottom: 24px; right: 24px; width: 56px; height: 56px;
        border-radius: 50%; background: #007bff; color: #fff; display: flex;
        align-items: center; justify-content: center; font-size: 1.4rem;
        box-shadow: 0 4px 12px rgba(0,0,0,.25); cursor: pointer; z-index: 1050;
    }
    .ai-chat-panel {
        position: fixed; bottom: 92px; right: 24px; width: 340px; max-width: 90vw;
        height: 460px; max-height: 70vh; background: #fff; border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.3); display: flex; flex-direction: column;
        overflow: hidden; z-index: 1050;
    }
    .ai-chat-header {
        background: #007bff; color: #fff; padding: .6rem 1rem; display: flex;
        justify-content: space-between; align-items: center; font-weight: 600;
    }
    .ai-chat-close { background: none; border: none; color: #fff; font-size: 1.2rem; line-height: 1; cursor: pointer; }
    .ai-chat-messages { flex: 1; overflow-y: auto; padding: .75rem; background: #f4f6f9; }
    .ai-chat-input-row { display: flex; gap: .4rem; padding: .5rem; border-top: 1px solid #dee2e6; background: #fff; }
    .ai-chat-input-row input { flex: 1; }
    .ai-msg { margin-bottom: .6rem; max-width: 90%; padding: .4rem .7rem; border-radius: 8px; font-size: .85rem; white-space: pre-wrap; word-wrap: break-word; }
    .ai-msg.user { margin-left: auto; background: #007bff; color: #fff; border-bottom-right-radius: 2px; }
    .ai-msg.assistant { margin-right: auto; background: #e9ecef; color: #212529; border-bottom-left-radius: 2px; }
    .ai-msg.typing { font-style: italic; opacity: .7; }
</style>

<script>
(function () {
    const STORAGE_KEY = "aiChatHistory";
    const btn = document.getElementById("aiChatButton");
    const panel = document.getElementById("aiChatPanel");
    const closeBtn = document.getElementById("aiChatClose");
    const messagesEl = document.getElementById("aiChatMessages");
    const input = document.getElementById("aiChatInput");
    const sendBtn = document.getElementById("aiChatSend");

    function getToken() {
        const el = document.querySelector("#aiAntiForgeryForm input[name='__RequestVerificationToken']");
        return el ? el.value : "";
    }

    function loadHistory() {
        try { return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "[]"); } catch { return []; }
    }
    function saveHistory(history) {
        try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history)); } catch { }
    }

    let history = loadHistory();

    function renderMessage(role, content) {
        const div = document.createElement("div");
        div.className = "ai-msg " + (role === "user" ? "user" : "assistant");
        div.textContent = content;
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return div;
    }

    function renderAll() {
        messagesEl.innerHTML = "";
        if (history.length === 0) {
            renderMessage("assistant", "Assalam-o-Alaikum! Aap mujh se apne business data ke baare mein sawal pooch sakte hain - jese \"aaj kitni sale hui?\" ya \"low stock products kya hain?\"");
            return;
        }
        history.forEach(m => renderMessage(m.role, m.content));
    }

    btn.addEventListener("click", () => {
        panel.hidden = !panel.hidden;
        if (!panel.hidden) { renderAll(); input.focus(); }
    });
    closeBtn.addEventListener("click", () => { panel.hidden = true; });

    async function send() {
        const text = input.value.trim();
        if (!text) return;
        input.value = "";
        sendBtn.disabled = true;

        renderMessage("user", text);
        const typingEl = renderMessage("assistant", "...typing");
        typingEl.classList.add("typing");

        try {
            const response = await fetch("/AiAssistant/Ask", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRF-TOKEN": getToken(),
                },
                body: JSON.stringify({ message: text, history: history }),
            });

            typingEl.remove();

            if (!response.ok) {
                renderMessage("assistant", "Maaf kijiye, kuch masla ho gaya. Please dobara koshish karein.");
                return;
            }

            const data = await response.json();
            renderMessage("assistant", data.reply);

            history.push({ role: "user", content: text });
            history.push({ role: "assistant", content: data.reply });
            if (history.length > 20) history = history.slice(history.length - 20);
            saveHistory(history);
        } catch (e) {
            typingEl.remove();
            renderMessage("assistant", "AI assistant se connect nahi ho saka. Please check ke aapka connection theek hai.");
        } finally {
            sendBtn.disabled = false;
        }
    }

    sendBtn.addEventListener("click", send);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") send(); });
})();
</script>
