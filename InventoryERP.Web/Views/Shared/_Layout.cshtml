@using Microsoft.AspNetCore.Identity
@using InventoryERP.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory ERP</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">Dashboard</a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#">
                        <i class="far fa-user"></i>
                        <span class="d-none d-md-inline">&nbsp;@User.Identity!.Name</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <span class="dropdown-item dropdown-header">Signed in</span>
                        <div class="dropdown-divider"></div>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-sign-out-alt mr-2"></i> Logout
                            </button>
                        </form>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
                </li>
            }
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
            <i class="fas fa-boxes-stacked brand-image" style="opacity:.9; font-size:1.4rem; margin-left:.6rem; margin-top:.6rem;"></i>
            <span class="brand-text font-weight-light">Inventory ERP</span>
        </a>
        <div class="sidebar">
            @{
                bool Can(string code) => User.IsInRole("Admin") || User.HasClaim("Permission", code);
                string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    @if (Can("Dashboard.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(CurrentController == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-gauge-high"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                    }
                    @if (Can("Products.View") || Can("Categories.View"))
                    {
                        <li class="nav-header">CATALOG</li>
                    }
                    @if (Can("Products.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Products" asp-action="Index" class="nav-link @(CurrentController == "Products" ? "active" : "")">
                                <i class="nav-icon fas fa-box"></i>
                                <p>Products</p>
                            </a>
                        </li>
                    }
                    @if (Can("Categories.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Categories" asp-action="Index" class="nav-link @(CurrentController == "Categories" ? "active" : "")">
                                <i class="nav-icon fas fa-tags"></i>
                                <p>Categories</p>
                            </a>
                        </li>
                    }
                    @if (Can("Stock.View") || Can("Stock.Adjust"))
                    {
                        <li class="nav-header">STOCK</li>
                    }
                    @if (Can("Stock.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Stock" asp-action="Ledger" class="nav-link @(CurrentController == "Stock" ? "active" : "")">
                                <i class="nav-icon fas fa-warehouse"></i>
                                <p>Stock Ledger</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Stock" asp-action="LowStock" class="nav-link">
                                <i class="nav-icon fas fa-triangle-exclamation"></i>
                                <p>Low Stock Alerts</p>
                            </a>
                        </li>
                    }
                    @if (Can("Stock.Adjust"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Stock" asp-action="Adjust" class="nav-link">
                                <i class="nav-icon fas fa-sliders"></i>
                                <p>Stock Adjustment</p>
                            </a>
                        </li>
                    }
                    @if (Can("Purchases.View") || Can("Sales.View"))
                    {
                        <li class="nav-header">TRANSACTIONS</li>
                    }
                    @if (Can("Purchases.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Purchases" asp-action="Index" class="nav-link @(CurrentController == "Purchases" ? "active" : "")">
                                <i class="nav-icon fas fa-truck-ramp-box"></i>
                                <p>Purchases</p>
                            </a>
                        </li>
                    }
                    @if (Can("Sales.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Sales" asp-action="Index" class="nav-link @(CurrentController == "Sales" ? "active" : "")">
                                <i class="nav-icon fas fa-cash-register"></i>
                                <p>Sales</p>
                            </a>
                        </li>
                    }
                    @if (Can("Suppliers.View") || Can("Customers.View"))
                    {
                        <li class="nav-header">CONTACTS</li>
                    }
                    @if (Can("Suppliers.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Suppliers" asp-action="Index" class="nav-link @(CurrentController == "Suppliers" ? "active" : "")">
                                <i class="nav-icon fas fa-truck-field"></i>
                                <p>Suppliers</p>
                            </a>
                        </li>
                    }
                    @if (Can("Customers.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Customers" asp-action="Index" class="nav-link @(CurrentController == "Customers" ? "active" : "")">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Customers</p>
                            </a>
                        </li>
                    }
                    @if (Can("Reports.View"))
                    {
                        <li class="nav-header">REPORTS</li>
                        <li class="nav-item">
                            <a asp-controller="Reports" asp-action="Index" class="nav-link @(CurrentController == "Reports" ? "active" : "")">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Reports</p>
                            </a>
                        </li>
                    }
                    @if (Can("Users.View") || Can("Roles.View"))
                    {
                        <li class="nav-header">ADMINISTRATION</li>
                    }
                    @if (Can("Users.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Index" class="nav-link @(CurrentController == "Users" ? "active" : "")">
                                <i class="nav-icon fas fa-user-gear"></i>
                                <p>Users</p>
                            </a>
                        </li>
                    }
                    @if (Can("Roles.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Roles" asp-action="Index" class="nav-link @(CurrentController == "Roles" ? "active" : "")">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>Roles &amp; Permissions</p>
                            </a>
                        </li>
                    }
                    @if (Can("ActivityLog.View"))
                    {
                        <li class="nav-item">
                            <a asp-controller="ActivityLog" asp-action="Index" class="nav-link @(CurrentController == "ActivityLog" ? "active" : "")">
                                <i class="nav-icon fas fa-clock-rotate-left"></i>
                                <p>Activity Log</p>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">@ViewData["Title"]</h1>
                    </div>
                </div>
            </div>
        </div>
        <section class="content">
            <div class="container-fluid">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        @TempData["Error"]
                    </div>
                }
                @RenderBody()
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>&copy; 2026 Inventory ERP.</strong> All rights reserved.
    </footer>
</div>

@if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.HasClaim("Permission", "AiAssistant.View")))
{
    @await Html.PartialAsync("_AiChatWidget")
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
