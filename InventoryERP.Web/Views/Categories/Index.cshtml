@{
    ViewData["Title"] = "Categories";
}
<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">All Categories</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Category</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Products</th>
                <th style="width:140px">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in ViewBag.Categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Description</td>
                    <td><span class="badge badge-info">@c.ProductCount</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-xs btn-outline-secondary"><i class="fas fa-edit"></i></a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-xs btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
