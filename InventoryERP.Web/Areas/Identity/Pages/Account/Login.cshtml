@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<p class="login-box-msg">Sign in to Inventory ERP</p>

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<form id="account" method="post">
    <div class="input-group mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email" />
        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-envelope"></span></div></div>
    </div>
    <span asp-validation-for="Input.Email" class="text-danger"></span>

    <div class="input-group mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-lock"></span></div></div>
    </div>
    <span asp-validation-for="Input.Password" class="text-danger"></span>

    <div class="row">
        <div class="col-7">
            <div class="icheck-primary">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>
        </div>
        <div class="col-5">
            <button id="login-submit" type="submit" class="btn btn-primary btn-block">Sign In</button>
        </div>
    </div>
</form>

<p class="mb-1 mt-3">
    <a asp-page="./ForgotPassword">I forgot my password</a>
</p>
<p class="mb-0">
    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-center">Register a new account</a>
</p>

<div class="alert alert-info mt-3 mb-0 p-2">
    <small><strong>Demo Admin:</strong> admin@inventoryerp.com / Admin@123</small>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
